# ── Runtime artefacts ─────────────────────────────────────────────────────────
# Uploads are ephemeral staging — never commit real transcript data
project-health-pulse/uploads/*
!project-health-pulse/uploads/.gitkeep

# Outputs: keep the demo run, ignore the __pycache__ inside
project-health-pulse/outputs/**/__pycache__/
project-health-pulse/outputs/**/run.log

# Logs
*.log
*.log.*

